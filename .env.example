# Artifact Registry Connection Details (Optional)
# If not set, the server will ask for credentials in chat via artifact_connect tool

# Registry Type: "nexus" or "artifactory"
ARTIFACT_REGISTRY_TYPE=nexus

# Base URL of your registry instance:
# Nexus example: http://localhost:8081
# Artifactory example: http://localhost:8082/artifactory or https://myorg.jfrog.io/artifactory
ARTIFACT_REGISTRY_URL=http://localhost:8081

# Username for authentication (e.g., admin, ci-agent)
ARTIFACT_REGISTRY_USER=admin

# Password or API Token / Access Token
ARTIFACT_REGISTRY_TOKEN=your-token-or-password-here

# Credential cache directory (optional, defaults to ~/.artifact-mcp-cache)
# ARTIFACT_MCP_CACHE_DIR=/custom/cache/path

# SSL verification (set to 'false' to skip SSL verification for self-signed certs)
# ARTIFACT_REGISTRY_SSL_VERIFY=true

# Request timeout in seconds (default: 30)
# ARTIFACT_REGISTRY_TIMEOUT=30

