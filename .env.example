# Artifact Registry Connection Details
# Pass via environment variables or connect dynamically via artifact_connect tool

# Registry type: "nexus" or "artifactory"
ARTIFACT_REGISTRY_TYPE=nexus

# Base URL of your registry instance:
# Nexus example: https://nexus.example.com
# Artifactory example: https://myorg.jfrog.io/artifactory
ARTIFACT_REGISTRY_URL=https://nexus.example.com

# Service account or username
ARTIFACT_REGISTRY_USER=admin

# Password, API Token, or Access Token
ARTIFACT_REGISTRY_TOKEN=your-registry-token-here

# SSL verification (set to 'false' for internal self-signed certs)
ARTIFACT_REGISTRY_SSL_VERIFY=true

# Request timeout in seconds (default: 30)
ARTIFACT_REGISTRY_TIMEOUT=30

# Credential cache directory (optional, defaults to ~/.artifact-mcp-cache)
# ARTIFACT_MCP_CACHE_DIR=/tmp/artifact-mcp-cache
